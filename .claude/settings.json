{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__create_branch|mcp__github__create_pull_request|mcp__github__merge_pull_request|mcp__github__update_pull_request|mcp__github__update_pull_request_branch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/public-repo-warning.sh",
            "timeout": 10,
            "statusMessage": "Checking for public-repo push..."
          }
        ]
      }
    ]
  }
}
